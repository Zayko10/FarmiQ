PORT=3000

# Conexión a PostgreSQL cuando la API corre en tu PC (fuera de Docker).
# Dentro de Docker, docker-compose.yml reemplaza este valor por el host "db".
DATABASE_URL=postgres://farmiq:cambia_esta_clave@localhost:5432/farmiq

# Firma de los tokens JWT. Genera una con: openssl rand -hex 32
JWT_SECRET=genera_una_clave_aleatoria
JWT_EXPIRES_IN=7d
